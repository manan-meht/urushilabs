# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Create an API key at https://platform.openai.com/api-keys
# Place your real key in .env.local (never commit it)
OPENAI_API_KEY=sk-placeholder
OPENAI_MODEL=gpt-4o
# Voice features (speech-to-text and text-to-speech)
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# ─── Encryption ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUBMISSION_ENCRYPTION_KEY=your-64-char-hex-key-here

# ─── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
# Optional — app works without these; falls back to click-to-chat links
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v21.0

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Optional — get an API key at https://resend.com
RESEND_API_KEY=re_placeholder
EMAIL_FROM=noreply@yourdomain.com

# ─── Cron / Internal ──────────────────────────────────────────────────────────
# A random secret used to protect the analysis trigger endpoint
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-cron-secret-here

# ─── Session ──────────────────────────────────────────────────────────────────
# A random secret for signing JWT session tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=your-session-secret-here

# ─── Demo Mode ────────────────────────────────────────────────────────────────
# Set to "true" to enable demo mode (no external credentials required)
DEMO_MODE=false

# ─── Live Mediation (Room Mode) ────────────────────────────────────────────────
# Feature flag: "true" enables for everyone, or leave false and allowlist specific
# testers by email below (comma-separated).
LIVE_MEDIATION_ENABLED=false
LIVE_MEDIATION_ALLOWED_EMAILS=
# Central model config for the OpenAI Realtime API (voice). Verify availability
# against your account before changing — see src/lib/ai/realtime/config.ts.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# gpt-4o-transcribe-diarize gives per-speaker diarization but isn't available to
# every OpenAI account/org — verified against a real "does not have access to
# this transcription model" error. Falls back to plain gpt-4o-transcribe, which
# Room Mode's calibration + probabilistic speaker mapping already assumes may
# be imperfect anyway. Set to gpt-4o-transcribe-diarize if your account has it.
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_REALTIME_VOICE=marin
# Comma-separated ISO-639-1 codes the transcriber may choose between.
# Unconstrained audio got mis-transcribed as Icelandic/Japanese in real testing.
OPENAI_REALTIME_TRANSCRIBE_LANGUAGES=en,hi

# ─── Meeting Mediation (Google Meet / Zoom, via Recall.ai) ─────────────────────
# Feature flag: "true" enables for everyone, or leave false and allowlist specific
# testers by email below (comma-separated). Independent of LIVE_MEDIATION_ENABLED.
MEETING_MEDIATION_ENABLED=false
MEETING_MEDIATION_ALLOWED_EMAILS=
# Recall.ai (meeting-bot transport — see docs/meeting-mediation-recall-setup.md).
# Leave RECALL_API_KEY unset to run Meeting Mediation in an "unconfigured" dev
# state: sessions can be created and tested end-to-end with transcript fixtures,
# but no real bot will attempt to join a meeting.
RECALL_API_KEY=
# Recall is region-pinned per account — use the base URL from your Recall dashboard.
RECALL_API_BASE_URL=https://us-east-1.recall.ai/api/v1
# Verify webhook signatures — generate/copy from the Recall dashboard.
RECALL_WEBHOOK_SECRET=
# Public URL Recall will POST events to, e.g. https://urushilabs.com/api/integrations/recall/webhook
RECALL_WEBHOOK_URL=
# Display name shown to meeting participants — NOT "Recall.ai".
RECALL_BOT_NAME=Urushi — AI Mediator
