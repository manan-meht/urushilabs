# ─── Urushi backend ─────────────────────────────────────────────────────────
# For local dev, use the Mac's LAN IP the Next.js dev server logs on startup
# (e.g. http://192.168.1.197:3010) — the Pi can't reach "localhost" on your Mac.
URUSHI_API_BASE_URL=http://192.168.1.197:3010

# From the "Pair a hardware device" panel on the Ready screen in the browser.
URUSHI_SESSION_ID=
URUSHI_DEVICE_TOKEN=

# ─── Audio devices ──────────────────────────────────────────────────────────
# Leave blank to use the system default input/output device. Run
# `python3 -m sounddevice` (after installing requirements) to list device names
# and indices — set these to match the EMEET OfficeCore M0 Plus if it isn't the
# default, e.g. "EMEET OfficeCore M0 Plus" or a numeric index like "1".
URUSHI_INPUT_DEVICE=
URUSHI_OUTPUT_DEVICE=

# Verified against a real EMEET OfficeCore M0 Plus with
# scripts/audio_selftest.py: its mic ONLY accepts 16000Hz, its speaker ONLY
# accepts 48000Hz — these are genuinely different per direction on this
# hardware, not a typo. Re-verify with the self-test script before trusting
# these on different hardware; sounddevice's reported "default_samplerate"
# was not reliable for this device (it claimed 48000 for both, but capture at
# 48000 fails).
URUSHI_INPUT_SAMPLE_RATE=16000
URUSHI_OUTPUT_SAMPLE_RATE=48000

# Set to "false" while developing so stopping the client does NOT end the mediation
# session. Ending is irreversible (generates the final report, locks the session to
# 'completed') and forces pairing a brand-new session from the browser — painful when
# restarting just to pick up a config change. Leave unset/true for real use.
URUSHI_END_SESSION_ON_EXIT=true
